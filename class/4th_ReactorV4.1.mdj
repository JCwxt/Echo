							}
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGZF6NfCjKxSpU=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"left": 920,
							"top": 280,
							"width": 293,
							"height": 55,
							"text": "12.当多个计算线程都要往_pendingFunctors中\n添加函数对象时，就出现了多线程安全的问题，\n因此必须对其加锁保护"
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGZF6NfQDLw5uM=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"head": {
								"$ref": "AAAAAAGZF6NfCjKxSpU="
							},
							"tail": {
								"$ref": "AAAAAAGZDY0HcIEfXHc="
							},
							"lineStyle": 1,
							"points": "892:372;991:335"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGZF6Uwb0ieO8w=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"left": 912,
							"top": 344,
							"width": 324.16064453125,
							"height": 70,
							"text": "13. 由于TcpConnection对象要将自己的send函数\n打包成一个回调函数放入_pendingFunctors中则\nTcpConnection对象必须知道EventLoop对象的存在，\n因此TcpConnection中必须有一个EventLoop指针"
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGZF6Uwp0jd9YY=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"head": {
								"$ref": "AAAAAAGZF6Uwb0ieO8w="
							},
							"tail": {
								"$ref": "AAAAAAGZDY0HcIEfXHc="
							},
							"lineStyle": 1,
							"points": "892:401;911:399"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGZF6d1zWWjR8s=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"left": 928,
							"top": 424,
							"width": 313,
							"height": 70,
							"text": "14. 为了让TcpConnection对象能够通知EventLoop\n则EventLoop类中必须提供一个用来通知的函数且\n必须要将回调函数放入_pendingFunctors中，该\n函数叫runInLoop"
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGZF6d2BWXiw5U=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"head": {
								"$ref": "AAAAAAGZF6d1zWWjR8s="
							},
							"tail": {
								"$ref": "AAAAAAGZDY0HcIEfXHc="
							},
							"lineStyle": 1,
							"points": "892:432;927:437"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGZF6uRkaLJNRw=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"left": 952,
							"top": 504,
							"width": 273,
							"height": 55,
							"text": "15. TcpConnction类中要添加一个新的发送\n消息的方式sendInLoop函数，其中直接调用\nEventLoop的runInLoop函数即可"
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGZF6uRyaMIhIk=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"head": {
								"$ref": "AAAAAAGZF6uRkaLJNRw="
							},
							"tail": {
								"$ref": "AAAAAAGZDY0HcIEfXHc="
							},
							"lineStyle": 1,
							"points": "892:459;1011:503"
						},
						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGZF69rudDRPtU=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"lineColor": "#fe0000",
							"font": "Arial;13;0",
							"left": 640,
							"top": 8,
							"width": 293,
							"height": 25,
							"text": "注意：阅读类图最大的困难是看不到线程的存在"
						}
					]
				},
